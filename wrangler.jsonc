{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "isla-drive",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "GLOBAL", "class_name": "GlobalRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GlobalRoom"] }],
  "observability": { "enabled": false }
}
