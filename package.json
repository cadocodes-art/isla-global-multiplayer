{
  "name": "isla-drive-cloudflare",
  "version": "2.22.0",
  "private": true,
  "description": "ISLA V2.22 — Iscoins, car upgrades, Flappy Car and new ways to play",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node prepare-cloudflare.cjs && node scripts/build-world.cjs",
    "dev": "npm run build && node dev.cjs",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir build",
    "test": "npm run build && npm run check:worker && node --test --test-concurrency=2 test/*.test.cjs",
    "build:offline": "node scripts/build-offline.cjs"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1",
    "ws": "8.22.0"
  }
}
