{
  "name": "isla-drive-cloudflare",
  "version": "1.7.1",
  "private": true,
  "description": "ISLA V1.71 — 3D Map Maker, signs, touch controls, and global multiplayer",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node prepare-cloudflare.cjs && node scripts/build-world.cjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir build",
    "test": "npm run build && npm run check:worker && node --test test/*.test.cjs",
    "build:offline": "node scripts/build-offline.cjs"
  },
  "devDependencies": {
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1",
    "ws": "8.22.0"
  }
}
